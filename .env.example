# Copie para .env e preencha. O .env não vai para o git.
# Em produção, estas variáveis ficam no painel da Vercel (Settings > Environment Variables).

# ID do Google Analytics 4 (G-XXXXXXXXXX)
VITE_GA_TRACKING_ID=

# Chave do Google Maps (Maps JavaScript e Places). Sem Distance Matrix: as distâncias vêm de api/distancias.
# Restrinja por referenciador HTTP no Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=

# Supabase "Dados" da SME: fonte das escolas e turmas (só leitura, schema dados_gerais).
# A chave é a publishable: pública de leitura, vai para o navegador, não é segredo.
VITE_SUPABASE_URL=https://fvyholoabfjjynrycvof.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# ── Só no servidor (funções em api/). NUNCA com prefixo VITE_: não podem ir ao navegador. ──
# Chave do Google só para a Routes API (Compute Route Matrix), sem restrição de referenciador.
GOOGLE_ROUTES_API_KEY=
# Chave secreta do Supabase "Dados" (sb_secret_...): executa as funções pqe_* (cota e cache).
SUPABASE_SECRET_KEY=
# Segredo qualquer e longo: o IP de quem chama vira hash com ele (o IP nunca é guardado).
PQE_HASH_SECRET=

# Painel /admin: a senha é conferida no servidor; o token de acesso (8 h) é assinado com o segredo.
PQE_ADMIN_PASSWORD=
# Segredo qualquer e longo, diferente do PQE_HASH_SECRET. Trocá-lo derruba todas as sessões do painel.
PQE_ADMIN_TOKEN_SECRET=
# "Conferir com o Google": JSON inteiro da chave de uma conta de serviço com o papel
# "Monitoring Viewer" (só leitura), numa linha só, e o ID do projeto do Google Cloud.
GOOGLE_MONITORING_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
